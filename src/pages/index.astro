---
import Layout from '@/layouts/Layout.astro';
import SystemExplorer from '@/components/SystemExplorer';
import ActionLink from '@/components/ActionLink';
import { Badge } from '@/components/ui/badge';
import { ArrowUpRight, ArrowDown, ArrowRight, Braces, Database, ShieldCheck, Workflow, Boxes, MapPin, GraduationCap, Award, Server, FileCheck2 } from 'lucide-react';
import { Github, Linkedin } from '@/components/BrandIcons';
import { profile } from '@/data/profile';
import { localPath } from '@/lib/links';
---
<Layout>
  <div class="hero-wrap">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-intro"><p class="eyebrow hero-eyebrow">SOFTWARE ENGINEER</p><span class="hero-stack">JAVA / SPRING BOOT / POSTGRESQL</span></div>
      <h1 id="hero-title">Harsh Kumar<span class="name-period">.</span></h1>
      <div class="hero-copy">
        <h2 class="hero-role">Behind the interface.<br/><span>Inside the system.</span></h2>
        <p class="hero-description">I build Java backends, APIs, and data workflows. From survey operations to energy-market software, I work on the systems people rely on every day.</p>
        <div class="hero-actions"><ActionLink href="#work" label="See my work" className="primary-cta"/><ActionLink href={localPath('Harsh-Kumar-CV.pdf')} label="Résumé" variant="ghost" className="resume-cta" icon="download" download/></div>
        <div class="hero-socials"><a href={profile.github} target="_blank" rel="noreferrer"><Github size={16}/>GitHub <ArrowUpRight size={14}/></a><a href={profile.linkedin} target="_blank" rel="noreferrer"><Linkedin size={16}/>LinkedIn <ArrowUpRight size={14}/></a></div>
      </div>
      <aside class="hero-work" aria-label="Selected project index">
        <div class="hero-work-heading"><span class="eyebrow">A FEW THINGS I’VE BUILT</span><span class="eyebrow">01 — 03</span></div>
        <a href={localPath('work/survey-platform/')}><span class="hero-work-number">01</span><span><strong>Survey management</strong><small>Setup: 2+ hours → 20–25 minutes</small></span><ArrowUpRight size={19}/></a>
        <a href={localPath('work/enterprise-crm/')}><span class="hero-work-number">02</span><span><strong>Enterprise CRM</strong><small>20+ franchises. 500+ orders a day.</small></span><ArrowUpRight size={19}/></a>
        <a href={localPath('work/energy-communication/')}><span class="hero-work-number">03</span><span><strong>Energy-market services</strong><small>EDIFACT processing · In development</small></span><ArrowUpRight size={19}/></a>
      </aside>
      <div class="hero-bottom"><span class="hero-current"><span class="current-indicator"/> CURRENTLY AT <strong>LEITNETZ</strong></span><a href="#work">EXPLORE THE WORK <ArrowDown size={16}/></a></div>
    </section>
  </div>
  <section class="impact-strip" aria-label="Experience at a glance"><div class="shell impact-inner"><div class="impact-intro"><span class="eyebrow">IN PRACTICE</span><strong>Work, in numbers.</strong></div><div><strong>2<span>+</span></strong><p>years building<br/>backend systems</p></div><div><strong>20<span>+</span></strong><p>franchises supported<br/>by the enterprise CRM</p></div><div><strong>500<span>+</span></strong><p>orders handled daily<br/>by CRM modules</p></div><a href="#work" aria-label="Explore the work behind these results"><ArrowDown size={21}/></a></div></section>
  <section id="work" class="section shell work-section" aria-labelledby="work-title">
    <div class="section-heading" data-reveal><div><p class="eyebrow section-index"><span>01</span> / SELECTED WORK</p><h2 id="work-title">A few things<br/><span class="muted-heading">I’ve worked on.</span></h2></div><p>Professional projects, with a closer look at the backend work I contributed.</p></div>
    <article class="project-feature project-survey" data-reveal>
      <div class="project-copy"><div class="project-meta"><span>01 /</span><span>CONTINUUM INSIGHTS</span><span>2024 — 2026</span></div><p class="project-category">SURVEYS &amp; OPERATIONS</p><h3>Survey management<br/>platform</h3><p>I worked on APIs and data workflows for multi-country survey operations. Reusable templates helped bring setup from 2+ hours down to 20–25 minutes.</p><div class="project-tags"><Badge variant="outline">Java</Badge><Badge variant="outline">Spring Boot</Badge><Badge variant="outline">PostgreSQL</Badge></div><a class="text-link" href={localPath('work/survey-platform/')}>Read about my work <ArrowUpRight size={17}/></a></div>
      <div class="survey-visual" aria-label="Survey setup reduced from over 2 hours to 20–25 minutes"><div class="visual-topline"><span class="visual-dot"/> SETUP TIME <span>SETUP / PROJECT</span></div><div class="time-comparison"><div><span class="time-label">BEFORE</span><strong>2+<span>hrs</span></strong><span class="comparison-bar old"/></div><ArrowRight className="comparison-arrow" size={28}/><div><span class="time-label">AFTER</span><strong>20–25<span>min</span></strong><span class="comparison-bar new"/></div></div><div class="workflow-line"><span><b>01</b> Configure</span><i/><span><b>02</b> Template</span><i/><span><b>03</b> Launch</span></div><p class="visual-caption"><span>↳</span> Reusable templates. Less repetitive work.</p></div>
    </article>
    <div class="project-pair">
      <article class="project-small crm-project" data-reveal>
        <div class="small-project-visual crm-visual" aria-label="Enterprise CRM supporting 20 plus franchises and 500 plus daily orders"><div class="visual-topline"><span>CONNECTED OPERATIONS</span><span>CRM / 02</span></div><div class="crm-stats"><div><strong>20<span>+</span></strong><span>FRANCHISES</span></div><div class="crm-stat-divider"/><div><strong>500<span>+</span></strong><span>ORDERS / DAY</span></div></div><div class="crm-lifecycle"><span>Placement</span><ArrowRight size={14}/><span>Fulfillment</span><ArrowRight size={14}/><span>Invoicing</span></div></div>
        <div class="small-project-copy"><div class="project-meta"><span>02</span><span>CONTINUUM INSIGHTS</span></div><p class="project-category">BUSINESS OPERATIONS</p><h3>An enterprise CRM<br/>for 20+ franchises.</h3><p>I built order-management modules and analytics APIs for a franchise network handling 500+ orders a day.</p><div class="project-tags"><Badge variant="outline">Spring Boot</Badge><Badge variant="outline">Spring MVC</Badge><Badge variant="outline">PostgreSQL</Badge></div><a class="text-link" href={localPath('work/enterprise-crm/')}>Read about my work <ArrowUpRight size={17}/></a></div>
      </article>
      <article class="project-small energy-project" data-reveal>
        <div class="small-project-visual energy-visual" aria-label="EDIFACT processing: UTILMD, MSCONS and INVOIC"><div class="visual-topline"><span>ENERGY-MARKET COMMUNICATION</span><span>03</span></div><div class="energy-flow"><div class="message-types"><span>UTILMD</span><span>MSCONS</span><span>INVOIC</span></div><div class="energy-connector"/><div class="validation-node"><FileCheck2 size={24} strokeWidth={1.3}/><span>Rule-driven<br/><strong>validation</strong></span></div></div><div class="energy-footnote"><span>AHB / MIG</span><span>DATA INTEGRITY</span><span>AUDITABILITY</span></div></div>
        <div class="small-project-copy"><div class="project-meta"><span>03</span><span>LEITNETZ UG</span><span class="ongoing-label">ONGOING</span></div><p class="project-category">CURRENT WORK</p><h3>Software for the<br/>energy market.</h3><p>At Leitnetz, I’m building Java services for EDIFACT message processing, validation, and workflow tracking, with an AI sidecar in development.</p><div class="project-tags"><Badge variant="outline">Microservices</Badge><Badge variant="outline">EDIFACT</Badge><Badge variant="outline">AI integration</Badge></div><a class="text-link" href={localPath('work/energy-communication/')}>Read about my work <ArrowUpRight size={17}/></a></div>
      </article>
    </div>
    <div class="work-footnote"><p>Built as part of a team. These notes focus on my contributions.</p><a href={profile.github} target="_blank" rel="noreferrer">More on GitHub <ArrowUpRight size={15}/></a></div>
  </section>
  <section class="engineering-section" aria-labelledby="engineering-title"><div class="shell engineering-grid"><div class="engineering-copy"><p class="eyebrow section-index"><span>↳</span> UNDER THE HOOD</p><h2 id="engineering-title">One request.<br/>A few moving parts.</h2><p>Most of my work sits between an API call and the database. Here’s a small, interactive example of how those layers fit together.</p><ol class="engineering-notes"><li><span>01</span> A clear API contract</li><li><span>02</span> Explicit access rules</li><li><span>03</span> Business logic in the service</li><li><span>04</span> Consistent database writes</li></ol><span class="engineering-instruction"><ArrowRight size={15}/> Select a layer, or run the request.</span></div><SystemExplorer client:visible/></div></section>
  <section id="experience" class="experience-section section" aria-labelledby="experience-title"><div class="shell experience-grid"><div class="experience-intro" data-reveal><p class="eyebrow section-index"><span>02</span> / EXPERIENCE</p><h2 id="experience-title">Where I’ve<br/><span class="muted-heading">been building.</span></h2><p>From survey and franchise operations to regulated energy-market communication.</p><a class="text-link" href={localPath('Harsh-Kumar-CV.pdf')} download>Download my CV <ArrowUpRight size={17}/></a></div><div class="timeline" data-reveal>
      <article class="timeline-item"><div class="timeline-marker current"/><div class="timeline-date">MAY 2026 — PRESENT <span>NOW</span></div><h3>Software Engineer</h3><div class="timeline-company"><strong>Leitnetz UG</strong><span>Nuremberg, Germany · Remote</span></div><p>Building Java microservices for regulated energy-market communication. Working across EDIFACT validation, persistent workflows, and AI-assisted error analysis.</p><div class="timeline-tags"><span>Microservices</span><span>EDIFACT</span><span>AI sidecar</span></div></article>
      <article class="timeline-item"><div class="timeline-marker"/><div class="timeline-date">JULY 2024 — APRIL 2026</div><h3>Backend Developer</h3><div class="timeline-company"><strong>Continuum Insights</strong><span>Gurugram, India</span></div><p>Developed survey-management and enterprise CRM backends. Streamlined setup workflows, built order-management APIs, and improved PostgreSQL query performance.</p><div class="timeline-tags"><span>Spring Boot</span><span>REST APIs</span><span>PostgreSQL</span></div></article>
    </div></div></section>
  <section id="skills" class="section shell skills-section" aria-labelledby="skills-title"><div class="section-heading"><div><p class="eyebrow section-index"><span>03</span> / THE TOOLKIT</p><h2 id="skills-title">The tools<br/><span class="muted-heading">I work with.</span></h2></div><p>Mostly Java and Spring Boot, with PostgreSQL underneath. The rest supports the work around them.</p></div><div class="skills-grid">
    {[
      { icon: Braces, number:'01', title:'Backend & APIs', text:'Business logic with a clear contract.', items:['Java','Spring Boot','RESTful APIs','OpenAPI / Swagger'] },
      { icon: Database, number:'02', title:'Data & persistence', text:'Reliable data. Considered queries.', items:['PostgreSQL','JPA / Hibernate','Liquibase','SQL optimization'] },
      { icon: ShieldCheck, number:'03', title:'Security & access', text:'The right access, in the right places.', items:['Spring Security','JWT / OAuth2','RBAC','BCrypt'] },
      { icon: Workflow, number:'04', title:'Architecture', text:'Connecting services and workflows.', items:['Microservices','Monolithic systems','Kafka','API contracts'] },
      { icon: Boxes, number:'05', title:'Delivery & operations', text:'From a local change to deployment.', items:['Docker','Kubernetes','GitHub Actions','AWS · foundational'] },
      { icon: Server, number:'06', title:'Quality & tooling', text:'Confidence in every iteration.', items:['JUnit','Spring Boot Test','Git / GitHub','Postman'] },
    ].map(({icon:Icon,number,title,text,items})=><article class="skill-card" data-reveal><div class="skill-top"><Icon size={23} strokeWidth={1.35}/><span>{number}</span></div><h3>{title}</h3><p>{text}</p><ul>{items.map(item=><li>{item}</li>)}</ul></article>)}
  </div><p class="toolkit-note"><span>ALSO IN MY WORKFLOW</span> IntelliJ IDEA · VS Code · GitHub Copilot · Codex · Claude Code</p></section>
  <section id="about" class="section shell about-section" aria-labelledby="about-title"><div class="about-grid"><div data-reveal><p class="eyebrow section-index"><span>04</span> / A LITTLE ABOUT ME</p><h2 id="about-title">Hello again.<br/><span class="muted-heading">I’m Harsh.</span></h2><div class="identity-note"><span class="identity-monogram" aria-hidden="true">hk<span>.</span></span><div><strong>Harsh Kumar</strong><span><MapPin size={14}/>Haryana, India</span><span>Currently working remotely.</span></div></div></div><div class="about-copy" data-reveal><p>I’m a software engineer from Haryana. Most of my work happens behind the interface: in APIs, business rules, and the database queries that keep a product moving.</p><p>I studied Computer Science at DCRUST, then joined Continuum Insights to work on survey and CRM backends. I now work remotely with Leitnetz on energy-market communication.</p><p class="about-current">One thing I’m working on now: using an AI sidecar to help with message validation and error analysis. It’s still in development.</p></div></div><div class="credentials" data-reveal><article><GraduationCap size={24} strokeWidth={1.4}/><div><span class="eyebrow">EDUCATION / 2020 — 2024</span><h3>B.Tech, Computer Science & Engineering</h3><p>DCRUST University, Murthal <span>CGPA 7.84</span></p></div></article><article><Award size={24} strokeWidth={1.4}/><div><span class="eyebrow">CONTINUED LEARNING</span><h3>Developer virtual experience programs</h3><p>Accenture & Goldman Sachs</p></div></article></div></section>
  <section id="contact" class="contact-section shell" aria-labelledby="contact-title"><div class="contact-layout" data-reveal><div><p class="eyebrow section-index"><span>05</span> / GET IN TOUCH</p><h2 id="contact-title">Have something<br/><span>in mind?</span></h2><p class="contact-description">If you’d like to talk about a role, a project,<br/>or something I’ve worked on, send me a note.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <ArrowUpRight size={24}/></a></div><div class="contact-links"><a href={profile.github} target="_blank" rel="noreferrer"><Github size={20}/><span>GitHub<small>Projects & contributions</small></span><ArrowUpRight size={18}/></a><a href={profile.linkedin} target="_blank" rel="noreferrer"><Linkedin size={20}/><span>LinkedIn<small>Professional profile</small></span><ArrowUpRight size={18}/></a><a href={localPath('Harsh-Kumar-CV.pdf')} download><ArrowDown size={20}/><span>Résumé<small>Experience & skills</small></span><ArrowUpRight size={18}/></a></div></div></section>
</Layout>
