---
import Layout from '@/layouts/Layout.astro';
import StackArtwork from '@/components/StackArtwork.astro';
import SystemExplorer from '@/components/SystemExplorer';
import ActionLink from '@/components/ActionLink';
import { Badge } from '@/components/ui/badge';
import { ArrowUpRight, ArrowDown, ArrowRight, Braces, Database, ShieldCheck, Workflow, Boxes, MapPin, GraduationCap, Award, Server, FileCheck2 } from 'lucide-react';
import { Github, Linkedin } from '@/components/BrandIcons';
import { profile } from '@/data/profile';
import { localPath } from '@/lib/links';
const toolkit = [
  { icon: Braces, number:'01', title:'Backend & APIs', text:'Business logic with a clear contract.', items:['Java','Spring Boot','REST APIs','OpenAPI / Swagger'] },
  { icon: Database, number:'02', title:'Data & persistence', text:'Reliable data. Considered queries.', items:['PostgreSQL','JPA / Hibernate','Liquibase','SQL optimization'] },
  { icon: ShieldCheck, number:'03', title:'Security & access', text:'The right access, in the right places.', items:['Spring Security','JWT / OAuth2','RBAC','BCrypt'] },
  { icon: Workflow, number:'04', title:'Architecture', text:'Connecting services and workflows.', items:['Microservices','Monolithic systems','Kafka','API contracts'] },
  { icon: Boxes, number:'05', title:'Delivery & operations', text:'From a local change to deployment.', items:['Docker','Kubernetes','GitHub Actions','AWS · foundational'] },
  { icon: Server, number:'06', title:'Quality & tooling', text:'Confidence in every iteration.', items:['JUnit','Spring Boot Test','Git / GitHub','Postman'] },
];
---
<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid shell">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span aria-hidden="true"/> SOFTWARE ENGINEER / BACKEND SYSTEMS</p>
        <h1 id="hero-title">Harsh<br/>Kumar<span class="name-period">.</span></h1>
        <h2 class="hero-role">Good software starts<br/><span>beneath the surface.</span></h2>
        <p class="hero-description">I build Java backends, APIs, and data workflows that make complex products work.</p>
        <div class="hero-actions">
          <ActionLink href="#work" label="Explore my work" className="primary-cta"/>
          <ActionLink href={localPath('Harsh-Kumar-CV.pdf')} label="Résumé" variant="ghost" className="resume-cta" icon="download" download/>
        </div>
        <div class="hero-socials"><a href={profile.github} target="_blank" rel="noreferrer"><Github size={15}/> GitHub <ArrowUpRight size={13}/></a><a href={profile.linkedin} target="_blank" rel="noreferrer"><Linkedin size={15}/> LinkedIn <ArrowUpRight size={13}/></a></div>
      </div>
      <div class="hero-art">
        <div class="hero-art-heading"><span class="eyebrow">A LOOK BENEATH THE INTERFACE</span><span class="art-cross" aria-hidden="true">+</span></div>
        <StackArtwork />
        <div class="hero-art-caption"><span>Clear contracts.<br/>Thoughtful systems.</span><span class="eyebrow">JAVA / SPRING BOOT<br/>POSTGRESQL</span></div>
      </div>
    </div>
    <div class="hero-bottom"><div class="hero-bottom-inner shell"><span class="hero-current"><span class="current-indicator" aria-hidden="true"/> CURRENTLY BUILDING AT <strong>LEITNETZ UG</strong></span><a href="#work">SCROLL TO EXPLORE <ArrowDown size={15}/></a></div></div>
  </section>

  <section class="impact-band" aria-label="Experience at a glance">
    <div class="impact-strip shell">
      <div class="impact-intro"><span class="eyebrow">BEYOND THE CODE</span><p>A few numbers<br/> from the work.</p></div>
      <div class="impact-item"><strong>2+</strong><p>years building<br/>backend systems</p></div>
      <div class="impact-item"><strong>20+</strong><p>franchises supported<br/>by the enterprise CRM</p></div>
      <div class="impact-item"><strong>500+</strong><p>orders handled daily<br/>by CRM modules</p></div>
    </div>
  </section>

  <section id="work" class="section shell work-section" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow section-index"><span>01 /</span> SELECTED WORK</p><h2 id="work-title">Built for the<br/><em>real world.</em></h2></div>
      <p class="work-intro"><strong>Different domains. Real constraints.</strong><span>A closer look at the systems I’ve helped build.</span></p>
    </div>
    <article class="project-feature project-survey" data-reveal>
      <div class="project-copy">
        <div class="project-meta"><span class="project-index">01</span><span>CONTINUUM INSIGHTS<br/><small>2024 — 2026</small></span></div>
        <p class="project-category">SURVEYS &amp; OPERATIONS</p><h3>Less repetition.<br/>Faster survey setup.</h3>
        <p>APIs and data workflows for multi-country survey operations. Reusable templates helped bring setup from 2+ hours down to 20–25 minutes.</p>
        <div class="project-tags"><Badge variant="outline">Java</Badge><Badge variant="outline">Spring Boot</Badge><Badge variant="outline">PostgreSQL</Badge></div>
        <a class="text-link" href={localPath('work/survey-platform/')}>Explore the project <ArrowUpRight size={18}/></a>
      </div>
      <div class="survey-visual" aria-label="Survey setup reduced from over 2 hours to 20–25 minutes">
        <div class="visual-topline"><span class="visual-dot" aria-hidden="true"/> THE SHORTER PATH TO LAUNCH <span>01 / 03</span></div>
        <div class="time-comparison">
          <div class="time-before"><span class="time-label">BEFORE</span><strong>2+ <span>hours</span></strong><div class="comparison-bar old"/></div>
          <ArrowDown className="comparison-arrow" size={27} aria-hidden="true"/>
          <div class="time-after"><span class="time-label">AFTER</span><strong>20–25 <span>minutes</span></strong><div class="comparison-bar new"/></div>
        </div>
        <div class="workflow-line"><span><b>01</b> Configure</span><ArrowRight size={15}/><span><b>02</b> Template</span><ArrowRight size={15}/><span><b>03</b> Launch</span></div>
        <p class="visual-caption">Same workflow. A better starting point.</p>
      </div>
    </article>
    <div class="project-pair">
      <article class="project-small crm-project" data-reveal>
        <div class="small-project-visual crm-visual" aria-label="Enterprise CRM supporting 20 plus franchises and 500 plus daily orders">
          <div class="visual-topline"><span>CONNECTED OPERATIONS</span><span>02 / 03</span></div>
          <div class="crm-stats"><div><strong>20+</strong><span>FRANCHISES</span></div><span class="crm-stat-divider" aria-hidden="true"/><div><strong>500+</strong><span>ORDERS / DAY</span></div></div>
          <div class="crm-lifecycle"><span>Placement</span><ArrowRight size={15}/><span>Fulfillment</span><ArrowRight size={15}/><span>Invoicing</span></div>
        </div>
        <div class="small-project-copy"><div class="project-meta"><span>CONTINUUM INSIGHTS</span><span>2024 — 2026</span></div><h3>One CRM.<br/>Many moving parts.</h3><p>Order-management modules and analytics APIs for a franchise network handling 500+ orders a day.</p><div class="project-tags"><Badge variant="outline">Spring Boot</Badge><Badge variant="outline">Spring MVC</Badge><Badge variant="outline">PostgreSQL</Badge></div><a class="text-link" href={localPath('work/enterprise-crm/')}>Explore the project <ArrowUpRight size={18}/></a></div>
      </article>
      <article class="project-small energy-project" data-reveal>
        <div class="small-project-visual energy-visual" aria-label="EDIFACT message processing with rule-driven validation">
          <div class="visual-topline"><span>ENERGY-MARKET COMMUNICATION</span><span>03 / 03</span></div>
          <div class="energy-flow"><div class="message-types"><span>UTILMD</span><span>MSCONS</span><span>INVOIC</span></div><div class="energy-connector" aria-hidden="true"/><div class="validation-node"><FileCheck2 size={28} strokeWidth={1.3}/><span>Rule-driven<br/><strong>validation</strong></span></div></div>
          <div class="energy-footnote"><span>AHB / MIG</span><span>DATA INTEGRITY</span><span>AUDITABILITY</span></div>
        </div>
        <div class="small-project-copy"><div class="project-meta"><span>LEITNETZ UG</span><span class="ongoing-label">IN PROGRESS</span></div><h3>Making sense of<br/>energy-market data.</h3><p>Java services for EDIFACT message processing, validation, and workflow tracking, with an AI sidecar in development.</p><div class="project-tags"><Badge variant="outline">Microservices</Badge><Badge variant="outline">EDIFACT</Badge><Badge variant="outline">AI integration</Badge></div><a class="text-link" href={localPath('work/energy-communication/')}>Explore the project <ArrowUpRight size={18}/></a></div>
      </article>
    </div>
    <div class="work-footnote"><p>Team projects. These notes focus on my contributions.</p><a href={profile.github} target="_blank" rel="noreferrer">More on GitHub <ArrowUpRight size={15}/></a></div>
  </section>

  <section class="engineering-section" aria-labelledby="engineering-title">
    <div class="shell engineering-grid">
      <div class="engineering-copy"><p class="eyebrow section-index"><span>↳</span> A SMALL INTERACTIVE DETOUR</p><h2 id="engineering-title">Follow<br/><em>the request.</em></h2><p>Most of my work sits between an API call and the database. Here’s how those layers fit together.</p><ol class="engineering-notes"><li><span>01</span> A clear API contract</li><li><span>02</span> Explicit access rules</li><li><span>03</span> Business logic in the service</li><li><span>04</span> Consistent database writes</li></ol><span class="engineering-instruction"><ArrowRight size={17}/> Select a layer, or run the request.</span></div>
      <SystemExplorer client:visible/>
    </div>
  </section>

  <section id="experience" class="experience-section section shell" aria-labelledby="experience-title">
    <div class="experience-grid">
      <div class="experience-intro" data-reveal><p class="eyebrow section-index"><span>02 /</span> THE JOURNEY SO FAR</p><h2 id="experience-title">Always<br/><em>building.</em></h2><p>From survey and franchise operations to regulated energy-market communication.</p><a class="text-link" href={localPath('Harsh-Kumar-CV.pdf')} download>Download my CV <ArrowUpRight size={17}/></a></div>
      <div class="timeline" data-reveal>
        <article class="timeline-item"><div class="timeline-date"><span>MAY 2026 — PRESENT</span><span class="timeline-current">CURRENT</span></div><h3>Leitnetz UG</h3><div class="timeline-company"><strong>Software Engineer</strong><span>Nuremberg, Germany · Remote</span></div><p>Building Java microservices for regulated energy-market communication. Working across EDIFACT validation, persistent workflows, and AI-assisted error analysis.</p><div class="timeline-tags"><span>Microservices</span><span>EDIFACT</span><span>AI sidecar</span></div></article>
        <article class="timeline-item"><div class="timeline-date"><span>JULY 2024 — APRIL 2026</span></div><h3>Continuum Insights</h3><div class="timeline-company"><strong>Backend Developer</strong><span>Gurugram, India</span></div><p>Developed survey-management and enterprise CRM backends. Streamlined setup workflows, built order-management APIs, and improved PostgreSQL query performance.</p><div class="timeline-tags"><span>Spring Boot</span><span>REST APIs</span><span>PostgreSQL</span></div></article>
      </div>
    </div>
  </section>

  <section id="skills" class="section shell skills-section" aria-labelledby="skills-title">
    <div class="section-heading"><div><p class="eyebrow section-index"><span>03 /</span> TOOLS OF THE TRADE</p><h2 id="skills-title">A practical<br/><em>toolkit.</em></h2></div><p>Java and Spring Boot at the core.<br/>The right tools around them.</p></div>
    <div class="skills-grid">{toolkit.map(({icon:Icon,number,title,text,items}) => <article class="skill-card" data-reveal><div class="skill-top"><Icon size={21} strokeWidth={1.4}/><span>{number}</span></div><div class="skill-content"><h3>{title}</h3><p>{text}</p><ul>{items.map(item => <li>{item}</li>)}</ul></div></article>)}</div>
    <p class="toolkit-note"><span>ALSO IN MY WORKFLOW</span> IntelliJ IDEA · VS Code · GitHub Copilot · Codex · Claude Code</p>
  </section>

  <section id="about" class="section shell about-section" aria-labelledby="about-title">
    <div class="about-grid">
      <div data-reveal><p class="eyebrow section-index"><span>04 /</span> BEHIND THE COMMITS</p><h2 id="about-title">An engineer.<br/><em>Still curious.</em></h2><div class="identity-note"><span class="identity-monogram" aria-hidden="true">hk<span>.</span></span><div><strong>Harsh Kumar</strong><span><MapPin size={13}/> Haryana, India</span><span>Currently working remotely.</span></div></div></div>
      <div class="about-copy" data-reveal><p>I’m Harsh, a software engineer from Haryana. I work on the parts of a product you don’t always see, but use every day.</p><p>I studied Computer Science at DCRUST, then joined Continuum Insights to build survey and CRM backends. I now work remotely with Leitnetz on energy-market communication.</p><p class="about-current"><span class="eyebrow">CURRENTLY EXPLORING</span>An AI sidecar for message validation and error analysis. A new problem to learn from, still in development.</p></div>
    </div>
    <div class="credentials" data-reveal><article><GraduationCap size={23} strokeWidth={1.4}/><div><span class="eyebrow">EDUCATION / 2020 — 2024</span><h3>B.Tech, Computer Science &amp; Engineering</h3><p>DCRUST University, Murthal <span>CGPA 7.84</span></p></div></article><article><Award size={23} strokeWidth={1.4}/><div><span class="eyebrow">CONTINUED LEARNING</span><h3>Developer virtual experience programs</h3><p>Accenture &amp; Goldman Sachs</p></div></article></div>
  </section>

  <section id="contact" class="contact-section shell" aria-labelledby="contact-title">
    <div class="contact-layout" data-reveal>
      <div class="contact-heading"><p class="eyebrow section-index"><span>05 /</span> YOUR NEXT CONVERSATION</p><h2 id="contact-title">Let’s make<br/>something <em>work.</em></h2></div>
      <div class="contact-bottom"><div><p class="contact-description">Have a role, a project, or a question in mind?</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <ArrowUpRight size={20}/></a></div><div class="contact-links"><a href={profile.github} target="_blank" rel="noreferrer">GitHub <ArrowUpRight size={15}/></a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <ArrowUpRight size={15}/></a><a href={localPath('Harsh-Kumar-CV.pdf')} download>Résumé <ArrowDown size={15}/></a></div></div>
    </div>
  </section>
</Layout>
